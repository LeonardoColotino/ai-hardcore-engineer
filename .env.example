# Copy to .env; never commit secrets.
AUTH_SECRET=
DEMO_PASSWORD=
DEMO_USERS_FILE=app/data/demo_users.json
STATE_DB=app/data/state.sqlite3
LLM_PROVIDER=disabled
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text:latest
REQUEST_TIMEOUT_S=12
RAG_TOP_K=4
RAG_MIN_SCORE=0.12
WEB_SEARCH_ENABLED=true

# Total shared network budget; socket timeout is clamped to remaining time.
CHAT_BUDGET_S=60

# Output cap: incomplete generations are rejected, not shown as complete.
LLM_MAX_OUTPUT_TOKENS=512

# Complete source blocks only; larger blocks require a larger context budget.
KNOWLEDGE_CONTEXT_CHARS=12000
LLM_CONTEXT_TOKENS=4096

# Bounded tasks and retrieval; no optional models are downloaded by default.
SUPERVISOR_MAX_STEPS=4
RAG_RETRIEVAL_PROFILE=hybrid

# none: lightweight baseline; lexical: scorer; cross_encoder: optional learned model.
RERANKER=none
KNOWLEDGE_ANSWER_MODE=evidence
SUPERVISOR_EVIDENCE_REVIEW=true
# Alternative optional inference: llama_cpp or openai_compatible (local endpoint default).
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=local-model
LLM_API_KEY=
GGUF_MODEL_PATH=models/qwen2.5-3b.gguf
GGUF_THREADS=4
GGUF_CONTEXT=8192
# Demo remains the default; OIDC requires explicit server-side provisioning.
AUTH_MODE=demo
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_IDENTITIES_FILE=app/data/oidc_identities.json
