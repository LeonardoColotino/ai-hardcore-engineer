# Copy to .env; never commit secrets.
AUTH_SECRET=
DEMO_PASSWORD=
DEMO_USERS_FILE=app/data/demo_users.json
STATE_DB=app/data/state.sqlite3
LLM_PROVIDER=disabled
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text:latest
REQUEST_TIMEOUT_S=12
RAG_TOP_K=4
RAG_MIN_SCORE=0.12
WEB_SEARCH_ENABLED=true

# Total shared network budget; socket timeout is clamped to remaining time.
CHAT_BUDGET_S=60

# Output cap: incomplete generations are rejected, not shown as complete.
LLM_MAX_OUTPUT_TOKENS=96
