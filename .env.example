APP_NAME=AI Hardcore Engineer - Multi-Agent Support System
APP_ENV=development
LOG_LEVEL=INFO

# Keep disabled until you install/start Ollama.
LLM_PROVIDER=disabled
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
REQUEST_TIMEOUT_S=12

ROUTER_MIN_CONFIDENCE=0.55
RAG_TOP_K=4
RAG_MIN_SCORE=0.12
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=3

# Separate with semicolons.
RAG_SOURCE_URLS=https://www.getnet.net/en;https://www.getnet.net/en/our-solutions/online-payments;https://site.getnet.com.br/pix/;https://site.getnet.com.br/link-de-pagamento/;https://site.getnet.com.br/conta-digital/
